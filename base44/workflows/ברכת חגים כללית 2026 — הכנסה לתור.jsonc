{
  "name": "\u05d1\u05e8\u05db\u05ea \u05d7\u05d2\u05d9\u05dd \u05db\u05dc\u05dc\u05d9\u05ea 2026 \u2014 \u05d4\u05db\u05e0\u05e1\u05d4 \u05dc\u05ea\u05d5\u05e8",
  "description": "\u05d8\u05e8\u05d9\u05d2\u05e8 \u05d7\u05d3-\u05e4\u05e2\u05de\u05d9 \u05dc-22.9.2026 09:00 (Asia/Jerusalem) \u05e9\u05de\u05db\u05e0\u05d9\u05e1 \u05d0\u05ea \u05d1\u05e8\u05db\u05ea \u05d4\u05d7\u05d2\u05d9\u05dd \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05dc\u05ea\u05d5\u05e8 \u05d4\u05d3\u05d9\u05d5\u05d5\u05e8. \u05d4\u05de\u05e8\u05d5\u05e7\u05df \u05d4\u05e7\u05d1\u05d5\u05e2 (processCampaignQueue) \u05e9\u05d5\u05dc\u05d7 \u05e2\u05d3 150/\u05d9\u05d5\u05dd. \u05d0\u05d9\u05d3\u05de\u05e4\u05d5\u05d8\u05e0\u05d8\u05d9 \u2014 \u05dc\u05d0 \u05e8\u05e5 \u05e4\u05e2\u05de\u05d9\u05d9\u05dd.",
  "trigger": {
    "config": {
      "trigger_type": "scheduled",
      "schedule_mode": "one_time",
      "one_time_date": "2026-09-22T06:00:00Z"
    }
  },
