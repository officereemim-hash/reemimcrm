{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Task"
    }
  },
  "description": "\u05e2\u05dc \u05db\u05dc \u05de\u05e9\u05d9\u05de\u05d4 \u05d7\u05d3\u05e9\u05d4 (Task) \u05e0\u05e9\u05dc\u05d7 \u05de\u05d9\u05d9\u05dc \u05dc\u05d1\u05e9\u05de\u05ea \u05d3\u05e8\u05da Brevo",
  "name": "\u05de\u05d9\u05d9\u05dc \u05dc\u05d1\u05e9\u05de\u05ea \u05e2\u05dc \u05de\u05e9\u05d9\u05de\u05d4 \u05d7\u05d3\u05e9\u05d4",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_task_by_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_task_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyTaskByEmail",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e9\u05dc\u05d9\u05d7\u05ea \u05de\u05d9\u05d9\u05dc \u05dc\u05d1\u05e9\u05de\u05ea"
          }
        }
      }
    ]
  }
}