{
  "name": "\u05dcid \u05d5\u05d5\u05d1\u05d9\u05e0\u05e8 \u05d7\u05d3\u05e9 \u2192 \u05d4\u05d5\u05d3\u05e2\u05ea \u05e4\u05ea\u05d9\u05d7\u05d4 + \u05d3\u05e3 \u05e0\u05d7\u05d9\u05ea\u05d4",
  "description": "\u05db\u05e9\u05e0\u05d5\u05e6\u05e8 \u05e8\u05d9\u05e9\u05d5\u05dd \u05d5\u05d5\u05d1\u05d9\u05e0\u05e8 \u05d7\u05d3\u05e9 (\u05dc\u05d9\u05d3 \u05de\u05de\u05d8\u05d0) \u2014 \u05e9\u05d5\u05dc\u05d7 \u05d4\u05d5\u05d3\u05e2\u05ea \u05d1\u05d5\u05d8 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e2\u05dd \u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d3\u05e3 \u05d4\u05e0\u05d7\u05d9\u05ea\u05d4. \u05de\u05d3\u05dc\u05d2 \u05e2\u05dc \u05de\u05d9 \u05e9\u05db\u05d1\u05e8 \u05e0\u05e8\u05e9\u05dd \u05d3\u05e8\u05da \u05d3\u05e3 \u05d4\u05e0\u05d7\u05d9\u05ea\u05d4.",
