{
  "name": "Document",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string"
    },
    "service_request_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5"
    },
    "category": {
      "type": "string",
      "enum": [
        "shoranss",
        "identity",
        "salary",
        "tax",
        "reports",
        "agreements",
        "pension_fund",
        "other"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "file_uri": {
      "type": "string",
      "description": "\u05e0\u05ea\u05d9\u05d1 \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d1\u05d0\u05d7\u05e1\u05d5\u05df \u05d4\u05e4\u05e8\u05d8\u05d9"
    },
    "uploaded_by": {
      "type": "string"
    },
    "signature_token": {
      "type": "string"
    },
    "signature_data": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer_name": {
      "type": "string"
    },
    "signature_status": {
      "type": "string",
      "enum": [
        "pending",
        "signed"
      ],
      "default": "pending"
    },
    "gmail_message_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05de\u05de\u05e0\u05d5 \u05d4\u05d2\u05d9\u05e2 \u05d4\u05de\u05e1\u05de\u05da"
    },
    "drive_file_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d1\u05d2\u05d9\u05d1\u05d5\u05d9 \u05d1\u05d3\u05e8\u05d9\u05d9\u05d1"
    },
    "drive_signature_file_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05d7\u05ea\u05d9\u05de\u05d4 \u05d1\u05d2\u05d9\u05d1\u05d5\u05d9 \u05d1\u05d3\u05e8\u05d9\u05d9\u05d1"
    },
    "drive_backed_up_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d2\u05d5\u05d1\u05d4 \u05dc\u05d3\u05e8\u05d9\u05d9\u05d1"
    },
    "drive_backup_error": {
      "type": "string",
      "description": "\u05e9\u05d2\u05d9\u05d0\u05ea \u05d4\u05d2\u05d9\u05d1\u05d5\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "drive_backup_attempts": {
      "type": "number",
      "default": 0,
      "description": "\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d2\u05d9\u05d1\u05d5\u05d9 \u05e9\u05e0\u05db\u05e9\u05dc\u05d5 \u05d1\u05e8\u05e6\u05e3"
    }
  },
  "required": [
    "contact_id",
    "name",
    "category"
  ]
}