{
  "name": "Document",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string"
    },
    "service_request_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5"
    },
    "category": {
      "type": "string",
      "enum": [
        "shoranss",
        "identity",
        "salary",
        "tax",
        "reports",
        "agreements",
        "pension_fund",
        "other"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "signature_token": {
      "type": "string"
    },
    "signature_data": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer_name": {
      "type": "string"
    },
    "signature_status": {
      "type": "string",
      "enum": [
        "pending",
        "signed"
      ],
      "default": "pending"
    },
    "gmail_message_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05de\u05de\u05e0\u05d5 \u05d4\u05d2\u05d9\u05e2 \u05d4\u05de\u05e1\u05de\u05da"
    }
  },
  "required": [
    "contact_id",
    "name",
    "category"
  ]
}