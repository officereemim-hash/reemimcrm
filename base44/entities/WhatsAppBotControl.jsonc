{
  "name": "WhatsAppBotControl",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9 972XXXXXXXXX"
    },
    "mode": {
      "type": "string",
      "enum": [
        "paused",
        "active_managed"
      ],
      "default": "paused",
      "description": "paused = \u05d4\u05d1\u05d5\u05d8 \u05dc\u05d0 \u05e2\u05d5\u05e0\u05d4 \u05dc\u05de\u05e1\u05e4\u05e8 \u05d4\u05d6\u05d4; active_managed = \u05d4\u05d1\u05d5\u05d8 \u05e2\u05d5\u05e0\u05d4 \u05d5\u05dc\u05d0 \u05d9\u05d5\u05e9\u05d4\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
    },
    "set_by": {
      "type": "string",
      "enum": [
        "human",
        "auto"
      ],
      "default": "human",
      "description": "\u05de\u05d9 \u05e7\u05d1\u05e2 \u05d0\u05ea \u05d4\u05de\u05e6\u05d1 \u2014 \u05d0\u05d3\u05de\u05d9\u05df \u05d9\u05d3\u05e0\u05d9\u05ea \u05d0\u05d5 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
    },
    "note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea (\u05e1\u05d9\u05d1\u05d4)"
    }
  },
  "required": [
    "phone",
    "mode"
  ]
}